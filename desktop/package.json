{
  "name": "agent-system-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "bundle": "tauri build --bundles nsis",
    "types": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features export_bindings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "echarts": "^6.0.0",
    "lucide-vue-next": "^0.468.0",
    "naive-ui": "^2.43.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.0.0"
  }
}
