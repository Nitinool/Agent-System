{
  "name": "task-notes-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "desktop": "tauri dev",
    "tauri": "tauri",
    "test": "vitest run",
    "test:native": "node tests/native-smoke.mjs",
    "types": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features export_bindings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "vue": "^3.5.0",
    "lucide-vue-next": "^0.468.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0",
    "vitest": "^5.0.5",
    "@playwright/test": "^1.56.0"
  }
}

